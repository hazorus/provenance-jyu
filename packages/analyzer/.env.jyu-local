# Vite mode file for `npm run build:local` (vite build --mode jyu-local).
# Committed on purpose: both values are public. See src/lib/local-only.ts.
#
# Serve only the in-browser /local analyzer, with no login and no server.
# Static files: run with npm run preview, or copy dist/ into any folder of any
# web server (hash routing, relative asset base). Nothing asks who is viewing,
# so restrict access at the web server if the folder is public.
VITE_LOCAL_ONLY=true
# Public half of the JYU Manifest 2.0 root key (not a secret).
VITE_ROOT_PUBLIC_KEY_HEX=1432603d08c93282725d899dd459cb5c9b6d723fff2362945b2eb11fef921f27
